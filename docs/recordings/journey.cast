[0.0,"o","\u001b[2J\u001b[H\r\n                     ORIFUDE  folding and ink, kept offline\r\n\r\n\r\n  ╭How this paper works──────────────────────────────────────────────────────╮\r\n  │The paper is ready.                                                       │\r\n  │Match the opened paper to the target.                                     │\r\n  │                                                                          │\r\n  │1  Tab previews the fold. + shows the moving side.                        │\r\n  │2  Enter folds. Arrows move the @ cursor.                                 │\r\n  │3  Tab selects the brush. Enter places ink.                               │\r\n  │4  Enter again opens and checks the paper.                                │\r\n  │                                                                          │\r\n  │The message below the controls gives the next move.                       │\r\n  │? opens help. u undoes. r resets.                                         │\r\n  │Enter starts the lesson. Esc leaves.                                      │\r\n  │                                                                          │\r\n  │                                                                          │\r\n  │                                                                          │\r\n  │                                                                          │\r\n  ╰──────────────────────────────────────────────────────────────────────────╯\r\n                          Enter start · ? help · q quit\r\n\r\n\r\n"]
